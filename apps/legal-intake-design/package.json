{
  "name": "legal-intake-design",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "dotenvx run -fk ../../.env.keys -f .env.development --ignore=MISSING_ENV_FILE -- next dev --turbopack --port 3080",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' dotenvx run -fk ../../.env.keys -f .env.development --ignore=MISSING_ENV_FILE -- next build",
    "start": "dotenvx run -fk ../../.env.keys -f .env.development --ignore=MISSING_ENV_FILE -- next start --port 3080",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "fmt": "prettier --write .",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
