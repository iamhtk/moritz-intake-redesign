# graphify ignore — same syntax as .gitignore
# Keeps the knowledge graph to hand-written source and prose. Anything
# generated, vendored, or binary is either noise in the graph or a paid
# vision/OCR call for zero signal.

# Dependencies and build output
node_modules/
.next/
.turbo/
dist/
build/
out/
coverage/

# Lockfiles and generated type shims
pnpm-lock.yaml
**/next-env.d.ts
**/*.tsbuildinfo

# Regenerated by `next dev` on every run
apps/*/AGENTS.md
apps/*/CLAUDE.md

# graphify's own artifacts — never feed the graph back into itself
.graphify/

# Binary and brand assets. graphify would send these through multimodal
# vision / PDF OCR; headshots, logos, and fonts add nothing to a code graph.
public/
**/*.png
**/*.jpg
**/*.jpeg
**/*.webp
**/*.gif
**/*.ico
**/*.svg
**/*.woff
**/*.woff2
**/*.ttf
**/*.otf
**/*.pdf

# Local-only scratch and secrets
local_docs/
notes/
.env*
.DS_Store
